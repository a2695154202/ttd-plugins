# 统一换行符为 LF，避免 Windows / Linux 交叉提交产生整文件 diff
* text=auto eol=lf

*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.zip   binary
*.gz    binary
*.7z    binary

# 发布归档不参与 GitHub 语言统计
dist/*     linguist-generated=true
# dist/ 下的单文件版仍是普通文本源码，按文本处理以便 GitHub 正常展示与 diff
dist/*.py  text eol=lf diff
dist/*.zip binary
